# Root-level environment variables (used by docker-compose and apps)
NODE_ENV=development

# Postgres
POSTGRES_USER=rm
POSTGRES_PASSWORD=rm_password
POSTGRES_DB=rm
DATABASE_URL=postgresql://rm:rm_password@postgres:5432/rm?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_ISSUER=rm-platform
JWT_AUDIENCE=rm-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Gateway
GATEWAY_PORT=8080
